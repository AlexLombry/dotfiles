#!/usr/bin/env zsh
set -euo pipefail

# LaunchAgent runs with a bare PATH (/usr/bin:/bin:/usr/sbin:/sbin), so Homebrew
# (rsync) and /usr/local (gpg) binaries are invisible. Prepend them explicitly.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Per-machine config (NAS destination, etc.) lives outside this repo so the
# script can be shared safely. Create ~/.config/backup_secure.env with at least:
#   BACKUP_DEST="user@host:/path/"
[ -f "$HOME/.config/backup_secure.env" ] && . "$HOME/.config/backup_secure.env"
: "${BACKUP_DEST:?BACKUP_DEST must be set (in ~/.config/backup_secure.env or env)}"

# launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/com.alexlombry.backup_secure.plist
# launchctl enable "gui/$(id -u)/com.alexlombry.backup_secure"

# Test-run immediately (optional)
# launchctl kickstart -k "gui/$(id -u)/com.alexlombry.backup_secure"

# tail -n 200 ~/Library/Logs/dailyscript.err
# tail -n 200 ~/Library/Logs/dailyscript.out

BACKUP_ROOT="$HOME/backups"
TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
WORK_DIR="$BACKUP_ROOT/backup_$TIMESTAMP"
ARCHIVE="$BACKUP_ROOT/backups_$TIMESTAMP.tar.gz"
ENCRYPTED_ARCHIVE="$ARCHIVE.gpg"

echo "Create $WORK_DIR folder"
mkdir -p "$WORK_DIR"

echo "Copying files..."

# Mandatory dotfiles
for file in .journal-log.md .zshrc .zprofile .zshenv .gitconfig .gitignore_global; do
  [ -e "$HOME/$file" ] && cp -R "$HOME/$file" "$WORK_DIR"
done

# Sensible folders (full copy — small credential/config dirs).
# rsync (not cp) so live agent/runtime sockets are skipped cleanly.
for dir in .ssh .gnupg .docker .aws .kube .snowflake .ecr .ssh-tunnel-ssm .k8slens .agents; do
  [ -d "$HOME/$dir" ] && rsync -a \
    --exclude='agent/' \
    --exclude='S.*' \
    --exclude='*.sock' \
    "$HOME/$dir" "$WORK_DIR/"
done

# Credential files buried in otherwise cache-heavy dirs (skip the multi-GB caches)
[ -f "$HOME/.m2/settings.xml" ] && mkdir -p "$WORK_DIR/.m2" && cp "$HOME/.m2/settings.xml" "$WORK_DIR/.m2/"
[ -f "$HOME/.gradle/gradle.properties" ] && mkdir -p "$WORK_DIR/.gradle" && cp "$HOME/.gradle/gradle.properties" "$WORK_DIR/.gradle/"

# Larger dirs — copy but prune regenerable caches (Raycast blobs ~1.7G, CC transcripts ~600M)
rsync -a --info=progress2 \
  --exclude='*.sock' \
  --exclude='S.*' \
  --exclude='raycast/' \
  --exclude='raycast-x/' \
  --exclude='intelephense/' \
  "$HOME/.config" "$WORK_DIR/"

rsync -a --info=progress2 \
  --exclude='projects/**/*.jsonl' \
  --exclude='file-history/' \
  --exclude='shell-snapshots/' \
  --exclude='paste-cache/' \
  --exclude='cache/' \
  --exclude='tmp/' \
  "$HOME/.claude" "$WORK_DIR/"

# Critical library
mkdir -p "$WORK_DIR/Library"
for libdir in "Keychains"; do
  [ -d "$HOME/Library/$libdir" ] && cp -R "$HOME/Library/$libdir" "$WORK_DIR/Library"
done

echo "Creating archive"
tar -czf "$ARCHIVE" -C "$BACKUP_ROOT" "backup_$TIMESTAMP"

echo "GPG Cypher (AES-256)..."
security find-generic-password -w -s "backup-gpg" -a "$USER" \
| gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 \
      --symmetric --cipher-algo AES256 \
      --output "$ENCRYPTED_ARCHIVE" "$ARCHIVE"

echo "Removing uncyphered files..."
rm -rf "$WORK_DIR"
rm -f "$ARCHIVE"

echo "Cyphered backup created :"
echo "$ENCRYPTED_ARCHIVE"

rsync -av --progress \
  -e "ssh" \
  "$ENCRYPTED_ARCHIVE" \
  "$BACKUP_DEST"

echo "Rotating local archives (keeping last 7)..."
find "$BACKUP_ROOT" -maxdepth 1 -name "backups_*.tar.gz.gpg" -type f | sort -r | tail -n +8 | xargs rm -f

## To restore the archive :
# gpg --output backup.tar.gz --decrypt backups_DATE.tar.gz.gpg
# tar -xzf backup.tar.gz
